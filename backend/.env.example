# ============================================================
# SENTINEL AI CRIME INTELLIGENCE PLATFORM
# Environment Configuration
# Ministry of Home Affairs - AI Division
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Application ────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
APP_NAME="Sentinel AI Crime Intelligence Platform"
APP_VERSION=1.0.0
DEBUG=true                           # Set false in production

# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_64_CHARS

# ─── Database ────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://sentinel:sentinel_pass@localhost:5432/sentinel_db
# For Supabase: DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres?sslmode=require
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_pass

# ─── JWT Authentication ──────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_JWT_SECRET_KEY_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Security ────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
BCRYPT_ROUNDS=12

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
# Production example (no spaces after commas):
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ─── AI / Gemini ─────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
AI_ANALYSIS_TIMEOUT=30
DUPLICATE_DETECTION_THRESHOLD=0.82

# ─── AWS S3 (Production File Storage) ────────────────────────
USE_S3=false                         # Set true for production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sentinel-evidence-storage

# ─── Email (Brevo HTTPS REST API for OTP) ──────────────────────
# Get your free key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-YOUR_BREVO_API_KEY_HERE
BREVO_SENDER_EMAIL=sentinelsecurityai@gmail.com
BREVO_SENDER_NAME="Sentinel AI Platform"
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# ─── SMS / OTP ───────────────────────────────────────────────
SMS_PROVIDER=mock                    # mock | twilio | msg91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_EXPIRE_MINUTES=10

# ─── Redis (Rate Limiting / Caching) ─────────────────────────
REDIS_URL=redis://:redis_sentinel_pass@localhost:6379/0
REDIS_PASSWORD=redis_sentinel_pass

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# ─── File Upload ─────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_DOCUMENT_SIZE_MB=25

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/sentinel.log

# ─── PgAdmin (Development Only) ──────────────────────────────
PGADMIN_EMAIL=admin@sentinel.gov.in
PGADMIN_PASSWORD=pgadmin_pass

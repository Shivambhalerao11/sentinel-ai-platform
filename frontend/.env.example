# ============================================================
# SENTINEL AI — FRONTEND ENVIRONMENT VARIABLES
# Copy this file to .env.local for local development
# ============================================================

# Backend API base URL (including /api/v1 path)
# Development (local):
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Production (Render backend):
# VITE_API_BASE_URL=https://sentinel-backend-tftw.onrender.com/api/v1

# Gemini API Key (only needed if using client-side AI features)
GEMINI_API_KEY=MY_GEMINI_API_KEY

# App URL (injected by hosting platform automatically)
APP_URL=MY_APP_URL
